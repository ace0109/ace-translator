{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "windows": [ "main", "floating", "settings" ],
  "permissions": [
    "core:app:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:tray:default",
    "core:path:default",
    "opener:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-clear"
  ]
}
