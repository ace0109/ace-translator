{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ace-translator",
  "identifier": "com.wangcaiyuan.ace-translator",
  "version": "0.2.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ace Translator",
        "width": 500,
        "height": 400,
        "minWidth": 400,
        "minHeight": 200,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "url": "index.html#/main"
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 800,
        "height": 800,
        "resizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": false,
        "url": "index.html#/settings"
      },
      {
        "label": "history",
        "title": "历史与日志",
        "width": 900,
        "height": 600,
        "resizable": true,
        "minimizable": true,
        "fullscreen": false,
        "visible": false,
        "url": "index.html#/history"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    }
  }
}
